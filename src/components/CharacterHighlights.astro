---
import {getCollection} from 'astro:content';
import {url,text} from '../lib/catalog';
import characterPhotos from '../lib/character-photos.json';
const {lang}=Astro.props;
const isCS=lang==='cs';
const categoryId='pohadkove-a-divadelni-postavy';
const selectedIds=['bob-a-bobek-a-vladimir-jiranek','pat-a-mat-a-lubomir-benes','vecernicek'];
const allEntries=await getCollection('entries');
const entries=selectedIds.map(id=>allEntries.find(e=>e.data.id===id)).filter(Boolean);
const plants=await getCollection('plants');
const characterNames={
 'bob-a-bobek-a-vladimir-jiranek':'Bob a Bobek',
 'pat-a-mat-a-lubomir-benes':'Pat a Mat',
 'ctyrlistek-a-jaroslav-nemecek':'Čtyřlístek',
 'krtek-a-zdenek-miler':'Krtek',
};
---
<section class="wrap character-highlights" aria-labelledby="character-highlights-title">
 <h2 id="character-highlights-title"><a href={url(lang,'category',categoryId)}>{isCS?'Pohádkové a divadelní postavy':'Fictional and theatrical characters'}</a></h2>
 <div class="catalog-grid">{entries.map(entry=>{
  const d=entry.data, name=characterNames[d.id]??d.name;
  const plant=plants.find(p=>p.data.id===d.plant_id), photo=characterPhotos[d.id];
  const plantName=plant.data[isCS?'name_cs':'name_en'];
  return <article class="card">
   <div class="banner"><a href={url(lang,'entries',d.id)} aria-label={name}><img class={photo?'':'illustration'} src={photo?.src??'/images/project-logo.svg'} alt={photo?name:''} width="800" height="600" loading="lazy"/></a><span class="year-badge">{d.year??text[lang].unknown}</span></div>
   <div class="body"><h3><a href={url(lang,'entries',d.id)}>{name}</a></h3><div class="plant"><a href={url(lang,'plants',d.plant_id)}>{plantName}</a><i>{plant.data.scientific_name}{plant.data.cultivar?` ‘${plant.data.cultivar}’`:''}</i></div></div>
  </article>;
 })}</div>
 <a class="action alt" href={url(lang,'category',categoryId)}>{isCS?'Všechny pohádkové a divadelní postavy':'All fictional and theatrical characters'} →</a>
</section>
