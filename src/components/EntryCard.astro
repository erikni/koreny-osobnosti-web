---
import PhotoImage from './PhotoImage.astro';
import {plantLabel} from '../lib/seo';
import {text,url} from '../lib/catalog';
import {publicPhotos} from '../lib/photos';
const {entry,plant,category,lang}=Astro.props;const d=entry.data,t=text[lang];const photoId=publicPhotos[d.id]?d.id:d.person_ids.find(pid=>publicPhotos[pid]);const photo=publicPhotos[photoId];
const name=plantLabel(plant.data,lang);
---
<article class="card" data-name={`${d.name} ${name} ${plant.data.scientific_name}`.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()} data-category={d.category_id} data-year={d.year??'unknown'} data-plant={d.plant_id}>
<div class="banner"><a href={url(lang,'entries',d.id)} aria-label={d.name}><PhotoImage class={photo?'':'illustration'} src={photo?.src??'/images/project-logo.svg'} width="800" height="600" loading="lazy" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1020px) calc(50vw - 42px), 360px" alt={photo?photo.name:''}/></a><span class="year-badge">{d.year??t.unknown}</span></div><div class="body"><span class="tag">{category.data[lang==='cs'?'name_cs':'name_en']}</span><h3><a href={url(lang,'entries',d.id)} style="text-decoration:none">{d.name}</a></h3><div class="plant"><a href={url(lang,'plants',plant.data.id)}>{name}</a><i>{plant.data.scientific_name}{plant.data.cultivar?` '${plant.data.cultivar}'`:''}</i></div><a class="profile-link" href={url(lang,'entries',d.id)}>{t.more}</a></div></article>
