---
import '../styles/site.css';
import CategoryIcon from '../components/CategoryIcon.astro';
import CharacterHighlights from '../components/CharacterHighlights.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {pageGraph,pagePath} from '../lib/structured-data';
import {getCollection,render} from 'astro:content';
import {text,url,homeUrl,sections} from '../lib/catalog';
const {lang='cs',title='Kořeny osobností',description,seoTitle,kind='home',id='',schema=null,breadcrumbs=[],shareImage={src:'/images/share.png',width:1200,height:630,type:'image/png',alt:'Kořeny osobností'}}=Astro.props;
const t=text[lang];const alternate=lang==='cs'?'en':'cs';
const path=pagePath(lang,kind,id);const otherPath=pagePath(alternate,kind,id);
const canonical=new URL(path,Astro.site).href;const other=new URL(otherPath,Astro.site).href;
const pageTitle=seoTitle??(title==='Kořeny osobností'?title:`${title} | Kořeny osobností`);
const desc=description??(lang==='cs'?'Osobnosti, jejich výsadby a rostliny v Botanické zahradě hl. m. Prahy. Společný projekt Dariny Miklovičové a zahrady.':'People, plantings and plants in Prague Botanical Garden. A joint project by Darina Miklovičová and the garden.');
const footerEntries=await getCollection('entries');const footerYears=[...new Set(footerEntries.map(e=>e.data.year).filter(Boolean))].sort((a,b)=>a-b);const footerCategories=(await getCollection('categories')).sort((a,b)=>a.data[lang==='cs'?'name_cs':'name_en'].localeCompare(b.data[lang==='cs'?'name_cs':'name_en'],lang));
const categoryCounts=new Map();
for(const entry of footerEntries) categoryCounts.set(entry.data.category_id,(categoryCounts.get(entry.data.category_id)??0)+1);
const iconCategories=new Set([...footerCategories].sort((a,b)=>(categoryCounts.get(b.data.id)??0)-(categoryCounts.get(a.data.id)??0)||a.data.name_cs.localeCompare(b.data.name_cs,'cs')).slice(0,6).map(cat=>cat.data.id));
const footerPage=(await getCollection('pages')).find(p=>p.data.page_id==='project'&&p.data.lang===lang);const {Content:FooterContent}=await render(footerPage);
const structuredData=schema??pageGraph({site:Astro.site,lang,kind,id,title:pageTitle,description:desc,breadcrumbs});
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={desc}/><meta name="robots" content="max-image-preview:large"/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={lang} href={canonical}/><link rel="alternate" hreflang={alternate} href={other}/><link rel="alternate" hreflang="x-default" href={lang==='cs'?canonical:other}/><meta property="og:title" content={pageTitle}/><meta property="og:type" content={kind==='entry'?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:description" content={desc}/><meta property="og:site_name" content="Kořeny osobností"/><meta property="og:locale" content={lang==='cs'?'cs_CZ':'en_GB'}/><meta property="og:locale:alternate" content={lang==='cs'?'en_GB':'cs_CZ'}/><meta property="og:image" content={new URL(shareImage.src,Astro.site).href}/><meta property="og:image:alt" content={shareImage.alt}/><meta property="og:image:width" content={shareImage.width}/><meta property="og:image:height" content={shareImage.height}/><meta property="og:image:type" content={shareImage.type}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={desc}/><meta name="twitter:image" content={new URL(shareImage.src,Astro.site).href}/><meta name="twitter:image:alt" content={shareImage.alt}/><link rel="icon" type="image/svg+xml" href="/images/project-logo.svg"/><script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\u003c')}/></head><body><a class="skip" href="#main">{lang==='cs'?'Přejít k obsahu':'Skip to content'}</a><div class="wrap"><header><a class="logo" href={homeUrl(lang)}><img class="brand-symbol" src="/images/project-logo.svg" width="53" height="60" alt=""/><span class="brand-copy"><span class="brand-name">Kořeny osobností</span><small>{t.joint}</small></span></a><nav aria-label={lang==='cs'?'Hlavní navigace':'Main navigation'}><a href={url(lang,'entries')}>{t.people}</a><a href={url(lang,'plants')}>{t.plants}</a><a href={url(lang,'about')}>{t.about}</a><a class="language" href={otherPath} lang={alternate}>{lang==='cs'?'English':'Čeština'}</a></nav></header></div><main id="main" class="wrap"><Breadcrumbs items={breadcrumbs} lang={lang}/><slot/></main><footer class="site-footer"><section class="about"><div class="wrap"><div><div class="footer-brand"><img src="/images/project-logo.svg" width="40" height="46" alt=""/><span>Kořeny osobností</span></div><h2>{lang==='cs'?'Kořeny nás propojují.':'Roots connect us.'}</h2></div><div><FooterContent/><div class="partner-links"><a href="https://www.linkedin.com/in/darina-miklovicova-176162a/">Darina Miklovičová ↗</a><a href="https://www.botanicka.cz/">{lang==='cs'?'Botanická zahrada hl. m. Prahy':'Prague Botanical Garden'} ↗</a></div></div></div></section>{kind==='home'&&<CharacterHighlights lang={lang}/>}<div class="wrap footer-directory"><nav aria-label={lang==='cs'?'Roky výsadby':'Planting years'}><h2>{lang==='cs'?'Roky výsadby':'Planting years'}</h2><div class="footer-link-list year-timeline">{footerYears.map(year=><a href={url(lang,'timeline',String(year))}>{year}</a>)}</div></nav><nav aria-label={lang==='cs'?'Typy osobností':'Personality categories'}><h2>{lang==='cs'?'Typy osobností':'Personality categories'}</h2><div class="footer-category-groups"><div class="footer-link-list categories category-icons">{footerCategories.filter(cat=>iconCategories.has(cat.data.id)).map(cat=><a class="category-with-icon" href={url(lang,'category',cat.data.id)}><CategoryIcon id={cat.data.id}/><span>{cat.data[lang==='cs'?'name_cs':'name_en']}</span></a>)}</div><div class="footer-link-list categories category-text">{footerCategories.filter(cat=>!iconCategories.has(cat.data.id)).map(cat=><a href={url(lang,'category',cat.data.id)}>{cat.data[lang==='cs'?'name_cs':'name_en']}</a>)}</div></div></nav></div><div class="wrap footer-bottom"><span>Kořeny osobností · www.koreny-osobnosti.cz</span><a href={url(lang,'gallery')}>{lang==='cs'?'Galerie':'Gallery'}</a><a href={url(lang,'visit')}>{t.visit}</a></div></footer></body></html>
