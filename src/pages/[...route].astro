---
import {render} from 'astro:content';
import BiographyFacts from '../components/BiographyFacts.astro';
import OfficialWebsites from '../components/OfficialWebsites.astro';
import PhotoCredits from '../components/PhotoCredits.astro';
import PlantPhoto from '../components/PlantPhoto.astro';
import PlantDescription from '../components/PlantDescription.astro';
import Layout from '../layouts/Layout.astro';import EntryCard from '../components/EntryCard.astro';
import {routes,catalog,text,url,sections,personalityType} from '../lib/catalog';import {publicPhotos,plantPhotos} from '../lib/photos';
export async function getStaticPaths(){return (await routes()).map(r=>({params:{route:r.path},props:r}));}
const {lang,kind,id}=Astro.props;const t=text[lang],c=await catalog();const isCS=lang==='cs';const entry=c.entries.find(e=>e.data.id===id),plant=c.plants.find(e=>e.data.id===id),person=c.people.find(e=>e.data.id===id);
const article=kind==='entry'?c.articles.find(e=>e.data.entry_id===id&&e.data.lang===lang):kind==='person'?c.biographies.find(e=>e.data.person_id===id&&e.data.lang===lang):['about','visit'].includes(kind)?c.pages.find(e=>e.data.page_id===kind&&e.data.lang===lang):null;
const plantProfile=c.plantProfiles.find(p=>p.data.plant_id===(kind==='entry'?entry?.data.plant_id:id)&&p.data.lang===lang);
const Content=article?(await render(article)).Content:null;
const category=c.categories.find(e=>e.data.id===id);
const detailPerson=entry?.data.entity_type==='person'?c.people.find(p=>p.data.id===id):person;
const entryPeople=(entry?.data.person_ids??[]).map(pid=>c.people.find(p=>p.data.id===pid)).filter(Boolean);
const entryPortraits=entry?(publicPhotos[id]?[id]:entry.data.person_ids.filter(pid=>publicPhotos[pid])):[];
const personSources=person?[...new Set([...(article?.data.source_urls??[]),...person.data.source_urls])]:[];
const detailPlant=entry?c.plants.find(p=>p.data.id===entry.data.plant_id):null;
const entryCategory=entry?c.categories.find(p=>p.data.id===entry.data.category_id):null;
const title=kind==='year'?`${isCS?'Výsadby v roce':'Plantings in'} ${id}`:kind==='category'?category.data[isCS?'name_cs':'name_en']:kind==='entry'?entry.data.name:kind==='plant'?plant.data[isCS?'name_cs':'name_en']:kind==='person'?person.data.name:({home:'Kořeny osobností',entries:t.people,plants:t.plants,people:t.participants,about:t.about,visit:t.visit,timeline:isCS?'Roky výsadby':'Planting years',gallery:isCS?'Galerie osobností':'People gallery'}[kind]);
const years=[...new Set(c.entries.map(e=>e.data.year).filter(Boolean))].sort((a,b)=>b-a);
const home=c.pages.find(p=>p.data.page_id==='home'&&p.data.lang===lang);
const newestFirst=(a,b)=>(b.data.year??0)-(a.data.year??0)||(a.data.date&&b.data.date?b.data.date.localeCompare(a.data.date):0)||b.data.number-a.data.number;
const latestPerson=[...c.entries].filter(e=>e.data.entity_type==='person').sort(newestFirst)[0];
const featured=[latestPerson,...['vaclav-havel','petra-kvitova','anna-geislerova','karel-gott','petr-pavel','milos-forman','ester-ledecka'].filter(pid=>pid!==latestPerson?.data.id).map(pid=>c.entries.find(e=>e.data.id===pid))].filter(Boolean);
const related=kind==='plant'?c.entries.filter(e=>e.data.plant_id===id):kind==='person'?c.entries.filter(e=>e.data.person_ids.includes(id)):[];
const personSchema=detailPerson?{'@type':'Person',name:detailPerson.data.name,birthDate:detailPerson.data.birth_date,deathDate:detailPerson.data.death_date,birthPlace:detailPerson.data.birth_place?{'@type':'Place',name:detailPerson.data.birth_place}:undefined,deathPlace:detailPerson.data.death_place?{'@type':'Place',name:detailPerson.data.death_place}:undefined,homeLocation:detailPerson.data.residence?{'@type':'Place',name:detailPerson.data.residence}:undefined,description:(detailPerson.data[isCS?'highlights_cs':'highlights_en']??[]).join(' '),sameAs:[...new Set([...(detailPerson.data.facts_source_urls?.filter(u=>new URL(u).hostname.endsWith('wikipedia.org'))??[]),...(detailPerson.data.official_website?[detailPerson.data.official_website]:[])])]}:null;
const schema=kind==='entry'?{'@context':'https://schema.org','@type':'Article',headline:entry.data.name,inLanguage:lang,url:new URL(url(lang,'entries',id),Astro.site).href,about:personSchema??{'@type':'Thing',name:entry.data.name},citation:[...new Set([...entry.data.sources.map(s=>s.url),...(detailPerson?.data.facts_source_urls??[])])]}:kind==='person'?{'@context':'https://schema.org','@type':'WebPage',name:person.data.name,mainEntity:personSchema,inLanguage:lang}:null;
if(kind==='timeline')c.entries.sort((a,b)=>(b.data.year??0)-(a.data.year??0)||a.data.sort_name.localeCompare(b.data.sort_name,'cs'));
const listing=kind==='year'?c.entries.filter(e=>String(e.data.year)===id):kind==='category'?c.entries.filter(e=>e.data.category_id===id):c.entries;
const plantsorted=c.plants.sort((a,b)=>a.data[isCS?'name_cs':'name_en'].localeCompare(b.data[isCS?'name_cs':'name_en'],lang));
---
<Layout lang={lang} title={title} description={article?.data.description} kind={kind} id={id} schema={schema}>
{kind==='home'&&<><section class="hero"><div><div class="eyebrow">{home.data.hero_eyebrow}</div><h1>{home.data.hero_title}</h1><p class="lead">{home.data.hero_intro}</p><a class="action" href={url(lang,'entries')}>{isCS?'Prozkoumat osobnosti':'Explore people'}</a><a class="action alt" href={url(lang,'plants')}>{isCS?'Poznat jejich stromy':'Discover their trees'}</a></div><div class="art"><a class="hero-photo" href={url(lang,'entries','petra-kvitova')} aria-label="Petra Kvitová"><span class="hero-person-name">Petra Kvitová</span><img class={publicPhotos['petra-kvitova']?'':'illustration'} src={publicPhotos['petra-kvitova']?.src??'/images/project-logo.svg'} width="800" height="1000" alt={publicPhotos['petra-kvitova']?'Petra Kvitová':''}/><span class="photo-label">{isCS?'Malý strom. Velký příběh.':'A small tree. A great story.'}</span></a><a class="memory-photo" href={url(lang,'entries','vaclav-havel')}><img src={publicPhotos['vaclav-havel']?.src??'/images/project-logo.svg'} width="800" height="600" alt={publicPhotos['vaclav-havel']?'Václav Havel':''}/><span>Václav Havel · 2009</span></a><span class="sun" aria-hidden="true">✺</span><span class="floating-leaf" aria-hidden="true">❧</span></div></section><section class="catalog"><div class="eyebrow">{isCS?'Setkání v zahradě':'Encounters in the garden'}</div><h2>{isCS?'Každé jméno má svůj příběh':'Every name has a story'}</h2><div class="catalog-grid">{featured.map(e=><EntryCard entry={e} plant={c.plants.find(p=>p.data.id===e.data.plant_id)} category={c.categories.find(p=>p.data.id===e.data.category_id)} lang={lang}/>)}</div><a class="action" href={url(lang,'entries')}>{isCS?'Všech 127 položek projektu':'All 127 project entries'} →</a></section><section class="trees-section"><h2>{isCS?'A jaké stromy tu rostou?':'And which trees grow here?'}</h2><div class="tree-grid">{['prunus-serrulata-amanogawa','magnolia-kobus'].map(pid=>{const p=c.plants.find(p=>p.data.id===pid),ph=plantPhotos[pid];return <figure class="tree-card"><div class="tree-image"><a href={url(lang,'plants',pid)} aria-label={p.data[isCS?'name_cs':'name_en']}><img class={ph?'':'illustration'} src={ph?.src??'/images/project-logo.svg'} width="800" height="600" loading="lazy" alt={ph?p.data[isCS?'name_cs':'name_en']:''}/></a></div><figcaption><h3><a href={url(lang,'plants',pid)}>{p.data[isCS?'name_cs':'name_en']}</a></h3><i>{p.data.scientific_name} {p.data.cultivar}</i><p><a href={url(lang,'plants',pid)}>{isCS?'Poznat rostlinu a její výsadby':'Discover the plant and its plantings'} →</a></p></figcaption></figure>})}</div></section></>}
{['entries','plants','people','timeline','gallery','year','category'].includes(kind)&&<section class="page-heading"><div class="eyebrow">Kořeny osobností</div><h1>{title}</h1><div class="section-links"><a href={url(lang,'entries')}>{t.people}</a><a href={url(lang,'timeline')}>{isCS?'Podle roku':'By year'}</a><a href={url(lang,'people')}>{t.participants}</a></div></section>}
{['entries','timeline','year','category'].includes(kind)&&<><p>{isCS?'Hledejte podle příjmení, profese, roku nebo rostliny. Přehled zahrnuje také společné výsadby, organizace a pohádkové postavy.':'Search by surname, category, year or plant. The catalogue also includes shared plantings, organisations and fictional characters.'}</p><div class="filters"><input id="catalog-search" type="search" placeholder={t.search} aria-label={t.search}/><select id="catalog-category" disabled={kind==='category'} data-fixed={kind==='category'?id:''} aria-label={isCS?'Profese':'Category'}><option value="">{t.all}</option>{c.categories.map(p=><option value={p.data.id}>{p.data[isCS?'name_cs':'name_en']}</option>)}</select><select id="catalog-year" disabled={kind==='year'} data-fixed={kind==='year'?id:''} aria-label={isCS?'Rok výsadby':'Planting year'}><option value="">{t.years}</option>{years.map(y=><option value={y}>{y}</option>)}<option value="unknown">{t.unknown}</option></select><select id="catalog-plant" aria-label={isCS?'Rostlina':'Plant'}><option value="">{t.allplants}</option>{plantsorted.map(p=><option value={p.data.id}>{p.data.scientific_name} {p.data.cultivar}</option>)}</select></div><p class="metadata" id="catalog-count" aria-live="polite">{listing.length} {t.count}</p><div class="catalog-grid" id="catalog-results">{listing.map(e=><EntryCard entry={e} plant={c.plants.find(p=>p.data.id===e.data.plant_id)} category={c.categories.find(p=>p.data.id===e.data.category_id)} lang={lang}/>)}</div><p id="catalog-empty" class="empty" hidden>{isCS?'Žádná položka neodpovídá hledání.':'No entries match your search.'}</p></>}
{kind==='entry'&&<article class="detail-main"><h1>{title}</h1><p class="personality-type"><a href={url(lang,'category',entry.data.category_id)}>{personalityType(id,lang)}</a></p><div class:list={['entry-portraits',{'multiple':entryPortraits.length>1}]}>{entryPortraits.map(pid=><figure class="article-photo"><img class="public-image" src={publicPhotos[pid].src} alt={publicPhotos[pid].caption??publicPhotos[pid].name} width="800" height="1000"/><figcaption><a href={url(lang,'people',pid)}>{c.people.find(p=>p.data.id===pid)?.data.name??title}</a>{publicPhotos[pid].caption&&<> · {publicPhotos[pid].caption}</>} · {isCS?'Portrét; nejde o snímek konkrétní výsadby.':'Portrait; not a photograph of this planting.'}</figcaption></figure>)}</div><section class="detail-block plant-block"><h2>{isCS?'O rostlině':'About the plant'}</h2><dl class="detail-facts"><div><dt>{isCS?'Rostlina':'Plant'}</dt><dd>{detailPlant.data[isCS?'name_cs':'name_en']}</dd></div><div><dt>{isCS?'Botanický název':'Botanical name'}</dt><dd><i>{detailPlant.data.scientific_name}</i>{detailPlant.data.cultivar?` ‘${detailPlant.data.cultivar}’`:''}</dd></div><div><dt>{isCS?'Rok výsadby':'Planting year'}</dt><dd>{entry.data.year??t.unknown}</dd></div><div><dt>{isCS?'Sázející nebo zástupci':'Planters or representatives'}</dt><dd>{entry.data[isCS?'planter':'planter_en']}</dd></div></dl>{plantPhotos[entry.data.plant_id]&&<PlantPhoto plant={detailPlant.data} photo={plantPhotos[entry.data.plant_id]} lang={lang} href={url(lang,'plants',entry.data.plant_id)}/>} {plantProfile&&<PlantDescription profile={plantProfile} lang={lang}/>}<p><a href={url(lang,'plants',entry.data.plant_id)}>{isCS?'Detail rostliny a další výsadby':'Plant details and related plantings'} →</a></p>{(isCS?entry.data.note:article.data.planting_note)&&<p class="metadata">{isCS?entry.data.note:article.data.planting_note}</p>}{entry.data.historical&&<p class="metadata">{isCS?'Historický název v pramenech':'Historical name in the sources'}: {entry.data.historical}</p>}</section><section class="detail-block person-block"><h2>{isCS?'O osobnosti':'About the person'}</h2><dl class="detail-facts"><div><dt>{isCS?'Jméno':'Name'}</dt><dd>{entry.data.name}</dd></div><div><dt>{isCS?'Typ osobnosti':'Personality type'}</dt><dd>{personalityType(id,lang)}</dd></div>{detailPerson&&<BiographyFacts person={detailPerson} lang={lang}/>}{entry.data.person_ids.length>0&&<div class="participants-fact"><dt>{isCS?'Osobnosti a účastníci':'People and participants'}</dt><dd>{entry.data.person_ids.map((pid,i)=><>{i>0?' · ':''}<a href={url(lang,'people',pid)}>{c.people.find(p=>p.data.id===pid)?.data.name}</a></>)}</dd></div>}</dl><div class="article-body"><Content/></div></section><section class="article-sources"><h2>{t.sources}</h2><ul class="source-list">{entry.data.sources.map(s=><li><a href={s.url}>{s[isCS?'label_cs':'label_en']}</a></li>)}</ul><OfficialWebsites people={entryPeople} lang={lang}/>{detailPerson?.data.facts_source_urls?.filter(u=>!entry.data.sources.some(s=>s.url===u)).map(u=><p><a href={u}>{isCS?'Životopisné údaje':'Biographical facts'} · {new URL(u).hostname}</a></p>)}{kind==='entry'&&plantProfile&&<><h3>{isCS?'Botanické podklady':'Botanical references'}</h3><ul>{plantProfile.data.source_urls.filter(u=>!entry.data.sources.some(s=>s.url===u)).map(u=><li><a href={u}>{new URL(u).hostname}</a></li>)}</ul></>}{article?.data.biography_source&&<p class="content-attribution">{isCS?'Životopisná část obsahuje upravený výňatek z Wikipedie; změněno členění a délka.':'The biography includes an adapted Wikipedia excerpt; paragraph layout and length were changed.'} <a href={article.data.biography_source}>{isCS?'Článek a historie autorů':'Article and contributor history'}</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</p>}{plantPhotos[entry.data.plant_id]&&<PhotoCredits photo={plantPhotos[entry.data.plant_id]} name={detailPlant.data[isCS?'name_cs':'name_en']} lang={lang}/>}{entryPortraits.map(pid=><PhotoCredits photo={publicPhotos[pid]} name={c.people.find(p=>p.data.id===pid)?.data.name??title} lang={lang}/>)}<p class="metadata">{isCS?'Ověřeno':'Checked'}: 2026-10-09</p></section></article>}
{kind==='plants'&&<><p>{isCS?'Stromy jsou součástí širšího příběhu: projekt zahrnuje také keře, orchideje a jiné rostliny. Latinské názvy a kultivary zachováváme podle dohledaných pramenů.':'Trees are part of a wider story: the project also includes shrubs, orchids and other plants. Scientific names and cultivars follow the checked references.'}</p><div class="section-links"><button id="trees-only" aria-pressed="false">{t.tree}</button><button id="plants-all" aria-pressed="true">{t.allplants}</button></div><div class="catalog-grid" id="plant-results">{plantsorted.map(p=><article class="card" data-type={p.data.plant_type}>{plantPhotos[p.data.id]&&<div class="banner"><a href={url(lang,'plants',p.data.id)} aria-label={p.data[isCS?'name_cs':'name_en']}><img src={plantPhotos[p.data.id].src} alt={plantPhotos[p.data.id].illustration_scope==='species'?p.data.scientific_name:p.data[isCS?'name_cs':'name_en']} width="800" height="600" loading="lazy"/></a></div>}<div class="body"><span class="tag">{isCS?p.data.plant_type:({Strom:'Tree',Keř:'Shrub',Orchidej:'Orchid'}[p.data.plant_type]??'Plant')}</span><h3><a href={url(lang,'plants',p.data.id)}>{p.data[isCS?'name_cs':'name_en']}</a></h3><i>{p.data.scientific_name} {p.data.cultivar}</i><p>{p.data.entry_numbers.length} {isCS?'položek projektu':'project entries'}</p></div></article>)}</div></>}
{kind==='plant'&&<article class="detail-main"><a href={url(lang,'plants')}>← {t.plants}</a><h1>{title}</h1><p class="intro"><i>{plant.data.scientific_name}</i> {plant.data.cultivar?`'${plant.data.cultivar}'`:''}</p>{plantPhotos[id]&&<PlantPhoto plant={plant.data} photo={plantPhotos[id]} lang={lang}/>}{plantProfile&&<PlantDescription profile={plantProfile} lang={lang}/>}<h2>{isCS?'Osobnosti a výsadby':'People and plantings'}</h2><ul class="entry-links">{related.map(e=><li><a href={url(lang,'entries',e.data.id)}>{e.data.name}</a> · {e.data.year??t.unknown}</li>)}</ul><section class="article-sources"><h2>{t.sources}</h2><ul>{(plantProfile?.data.source_urls??plant.data.source_urls).map(u=><li><a href={u}>{new URL(u).hostname}</a></li>)}</ul>{plantPhotos[id]&&<PhotoCredits photo={plantPhotos[id]} name={plant.data[isCS?'name_cs':'name_en']} lang={lang}/>}</section></article>}
{kind==='gallery'&&<><p>{isCS?'Fotografie osobností a účastníků projektu. Otevřete medailonek pro související výsadby a autorské údaje.':'Photographs of personalities and project participants. Open a biography for related plantings and photography credits.'}</p><div class="catalog-grid">{Object.entries(publicPhotos).map(([pid,ph])=>{const p=c.people.find(p=>p.data.id===pid);return p&&<article class="card"><div class="banner"><a href={url(lang,'people',pid)}><img src={ph.src} alt={p.data.name} width="800" height="600" loading="lazy"/></a></div><div class="body"><h3><a href={url(lang,'people',pid)}>{p.data.name}</a></h3></div></article>})}</div></>}
{kind==='people'&&<><p>{isCS?'Samostatný přehled skutečných lidí včetně rodinných zástupců a dalších účastníků výsadeb.':'A separate list of real people, including family representatives and other planting participants.'}</p><ul class="entry-links">{c.people.sort((a,b)=>a.data.sort_name.localeCompare(b.data.sort_name,'cs')).map(p=><li><a href={url(lang,'people',p.data.id)}>{p.data.name}</a></li>)}</ul></>}
{kind==='person'&&<article class="detail-main"><h1>{title}</h1>{related[0]&&<p class="personality-type">{personalityType(person.data.id,lang)}</p>}{publicPhotos[id]&&<figure class="article-photo"><img class="public-image" src={publicPhotos[id].src} width="800" height="1000" alt={title}/><figcaption>{isCS?'Fotografie k medailonku; není to snímek konkrétní výsadby.':'Photograph accompanying the biography; not a photograph of this planting.'}</figcaption></figure>}<dl class="detail-facts"><div><dt>{isCS?'Jméno':'Name'}</dt><dd>{person.data.name}</dd></div>{related[0]&&<div><dt>{isCS?'Typ osobnosti':'Personality type'}</dt><dd>{personalityType(person.data.id,lang)}</dd></div>}<BiographyFacts person={person} lang={lang}/></dl><div class="article-body"><Content/></div><h2>{isCS?'Souvislost s projektem':'Connection with the project'}</h2><ul class="entry-links">{related.map(e=><li><a href={url(lang,'entries',e.data.id)}>{e.data.name}</a> · {e.data.year??t.unknown}</li>)}</ul><section class="article-sources"><h2>{t.sources}</h2><ul>{personSources.map(u=><li><a href={u}>{u===person.data.official_website?(isCS?'Oficiální web':'Official website')+' · '+person.data.name:new URL(u).hostname}</a></li>)}</ul>{kind==='entry'&&plantProfile&&<><h3>{isCS?'Botanické podklady':'Botanical references'}</h3><ul>{plantProfile.data.source_urls.filter(u=>!entry.data.sources.some(s=>s.url===u)).map(u=><li><a href={u}>{new URL(u).hostname}</a></li>)}</ul></>}{article?.data.biography_source&&<p class="content-attribution">{isCS?'Životopisná část obsahuje upravený výňatek z Wikipedie; změněno členění a délka.':'The biography includes an adapted Wikipedia excerpt; paragraph layout and length were changed.'} <a href={article.data.biography_source}>{isCS?'Článek a historie autorů':'Article and contributor history'}</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</p>}{publicPhotos[id]&&<PhotoCredits photo={publicPhotos[id]} name={person.data.name} lang={lang}/>}<p class="metadata">{isCS?'Ověřeno':'Checked'}: {person.data.verified_on}</p></section></article>}
{['about','visit'].includes(kind)&&<article class="detail-main"><h1>{title}</h1><div class="article-body"><Content/></div><section class="article-sources"><h2>{t.sources}</h2><ul>{article.data.sources.map(u=><li><a href={u}>{isCS?'Botanická zahrada hl. m. Prahy':'Prague Botanical Garden'}</a></li>)}</ul></section></article>}
<script>
const fields=['catalog-search','catalog-category','catalog-year','catalog-plant'].map(id=>document.getElementById(id));
if(fields.every(Boolean)){const count=document.getElementById('catalog-count'),empty=document.getElementById('catalog-empty');fields.forEach(e=>{if(e.dataset.fixed)e.value=e.dataset.fixed});const total=document.querySelectorAll('#catalog-results .card').length;function update(){const [search,category,year,plant]=fields.map(e=>e.value);const q=search.normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase();let n=0;document.querySelectorAll('#catalog-results .card').forEach(e=>{e.hidden=!e.dataset.name.includes(q)||(category&&e.dataset.category!==category)||(year&&e.dataset.year!==year)||(plant&&e.dataset.plant!==plant);if(!e.hidden)n++});count.textContent=`${n} / ${total}`;empty.hidden=n>0;}fields.forEach(e=>e.addEventListener('input',update));}
const treeButton=document.getElementById('trees-only'),allButton=document.getElementById('plants-all');if(treeButton&&allButton){for(const [button,only] of [[treeButton,true],[allButton,false]])button.addEventListener('click',()=>{document.querySelectorAll('#plant-results .card').forEach(e=>e.hidden=only&&e.dataset.type!=='Strom');treeButton.setAttribute('aria-pressed',String(only));allButton.setAttribute('aria-pressed',String(!only))})}
</script>

</Layout>
